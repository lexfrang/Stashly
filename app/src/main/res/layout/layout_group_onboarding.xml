<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FB"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Welcome to Stashly"
        android:textColor="#191C1E"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Collaborate on household budgets and track assets together in real-time."
        android:textColor="#191C1E"
        android:alpha="0.7"
        android:textSize="14sp" />

    <!-- Create Group Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Fresh"
                android:textColor="#191C1E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_create_group_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input_field_background"
                android:hint="Workspace Name (e.g. My Home)"
                android:paddingHorizontal="16dp"
                android:textColor="#191C1E"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_action_create_group"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#0052FE"
                android:text="Create New Workspace"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:text="OR"
        android:textColor="#191C1E"
        android:alpha="0.4"
        android:textStyle="bold" />

    <!-- Join Group Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join Existing"
                android:textColor="#191C1E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_join_group_code"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input_field_background"
                android:hint="Enter 6-Character Code"
                android:gravity="center"
                android:textAllCaps="true"
                android:maxLength="6"
                android:paddingHorizontal="16dp"
                android:textColor="#191C1E"
                android:textSize="16sp"
                android:letterSpacing="0.2" />

            <Button
                android:id="@+id/btn_action_join_group"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#191C1E"
                android:text="Join Workspace"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
