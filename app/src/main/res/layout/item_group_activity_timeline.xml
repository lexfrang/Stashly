<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp">

    <!-- Timeline Vertical Line -->
    <View
        android:id="@+id/timeline_connector_top"
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_centerHorizontal="false"
        android:layout_marginStart="31dp"
        android:background="#E8EDF2" />

    <!-- Timeline Icon Circle -->
    <FrameLayout
        android:id="@+id/timeline_icon_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_below="@id/timeline_connector_top"
        android:layout_marginStart="16dp"
        android:background="@drawable/input_field_background">

        <TextView
            android:id="@+id/activity_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🥛"
            android:textSize="14sp" />
    </FrameLayout>

    <View
        android:id="@+id/timeline_connector_bottom"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_below="@id/timeline_icon_container"
        android:layout_alignStart="@id/timeline_connector_top"
        android:background="#E8EDF2" />

    <!-- Content Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/timeline_icon_container"
        android:layout_marginStart="16dp"
        android:layout_alignTop="@id/timeline_icon_container"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/activity_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sam consumed milk"
            android:textColor="#191C1E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/activity_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Budget preserved • 5 hours ago"
            android:textColor="#191C1E"
            android:alpha="0.5"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/activity_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+$4.20"
            android:textColor="#00993B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
