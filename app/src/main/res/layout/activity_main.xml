<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Action/Branding Toolbar Header -->
    <RelativeLayout
        android:id="@+id/toolbar_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-black"
            android:text="Stashly"
            android:textColor="@color/primary"
            android:textSize="22dp"
            android:textStyle="bold" />

        <!-- Mock status avatar button -->
        <FrameLayout
            android:id="@+id/btn_profile_mock"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/tag_green_tint">

            <TextView
                android:id="@+id/toolbar_profile_initials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="AL"
                android:textColor="@color/growth_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
    </RelativeLayout>

    <!-- MAIN VIEW CONTAINER SCROLL -->
    <ScrollView
        android:id="@+id/main_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation_container"
        app:layout_constraintTop_toBottomOf="@id/toolbar_header">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="80dp">

            <!-- ================= VIEW 1: DASHBOARD ================= -->
            <LinearLayout
                android:id="@+id/view_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="visible">

                <!-- Greeting & Efficiency Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/greeting_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Greetings, Alex"
                            android:textColor="@color/primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Hero Budget Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:elevation="4dp"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL MONTHLY BUDGET"
                            android:textColor="@color/text_muted"
                            android:textSize="12dp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/btn_edit_budget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Edit Budget"
                            android:background="@drawable/tag_green_tint"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/growth_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"/>
                    </RelativeLayout>

                    <!-- Hero numbers with aligned decimal -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/dashboard_budget_spent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$4,250"
                            android:textColor="@color/primary"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=".00"
                            android:textColor="@color/text_muted"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/dashboard_budget_allocated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / $10,000.00"
                            android:textColor="@color/text_muted"
                            android:textSize="16dp"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="6dp" />
                    </LinearLayout>

                    <!-- Budget progress bar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/dashboard_utilization_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="42.5% Utilized"
                            android:textColor="@color/text_muted"
                            android:textSize="12dp" />

                        <TextView
                            android:id="@+id/dashboard_allocated_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="0.0% Allocated"
                            android:textColor="@color/secondary"
                            android:textSize="12dp" />
                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:background="@drawable/input_field_background"
                        android:layout_marginTop="4dp">

                        <LinearLayout
                            android:id="@+id/dashboard_progress_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:weightSum="1.0">
                            <!-- Dynamic segments: [Allocations...] [Spent] -->
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Line divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_gray"
                        android:layout_marginVertical="20dp" />

                    <!-- Metrics -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btn_tile_allocated_funds"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Allocated Funds"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dashboard_assets_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:textColor="@color/primary"
                                android:textSize="18dp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/border_gray"
                            android:layout_marginHorizontal="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Liquid Cash"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dashboard_liquid_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$5,750.00"
                                android:textColor="@color/accent_blue"
                                android:textSize="18dp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Dual Action Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- Black Solid "Allocate Budget" selection tile -->
                    <LinearLayout
                        android:id="@+id/btn_tile_allocate"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_dark_rounded"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:gravity="bottom"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allocate Budget"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reserve for goals"
                            android:textColor="#C0C0C0"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_tile_analysis"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_background"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical"
                        android:gravity="bottom"
                        android:padding="16dp"
                        android:elevation="2dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Analysis"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Asset performance stats"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Recent Activity List header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT ACTIVITY"
                    android:textColor="@color/text_muted"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/container_recent_activities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:elevation="2dp">
                    <!-- Dynamic rows will be added here -->
                </LinearLayout>

            </LinearLayout>

            <!-- ================= VIEW 2: INVENTORY ================= -->
            <LinearLayout
                android:id="@+id/view_inventory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Scanned Purchases"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/container_staged_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:paddingVertical="8dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="16dp">
                    <!-- Dynamic rows -->
                </LinearLayout>

                <!-- Expiry Notification Widget (Functional) -->
                <LinearLayout
                    android:id="@+id/expiry_warning_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="•"
                            android:textColor="@color/urgency_red"
                            android:textSize="28dp"
                            android:layout_gravity="top"
                            android:layout_marginTop="-6dp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/expiry_warning_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System Notification"
                                android:textColor="@color/primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/expiry_warning_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Urgent action required"
                                android:textColor="@color/urgency_red"
                                android:textSize="12dp" />

                            <TextView
                                android:id="@+id/expiry_warning_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Just now"
                                android:textColor="@color/text_muted"
                                android:textSize="11dp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Household Storage"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_field_background"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="10dp"
                    android:hint="Search inventory..."
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/primary"
                    android:paddingHorizontal="14dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:importantForAutofill="no"
                    android:inputType="text" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/btn_dark_rounded"
                            android:text="All"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:paddingHorizontal="16dp"
                            android:textStyle="bold"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_food"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Food"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_medicine"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Medicine"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_cleaners"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Cleaners"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_electronics"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Electronics"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_clothes"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Clothes"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_furniture"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Furniture"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_services"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Services"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filter_tools"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/input_field_background"
                            android:text="Tools &amp; Parts"
                            android:gravity="center"
                            android:textColor="@color/primary"
                            android:paddingHorizontal="16dp"
                            android:textSize="12dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/inventory_grid_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Dynamic inventory items -->
                </LinearLayout>
            </LinearLayout>

            <!-- ================= VIEW 3: COLLABORATIVE GROUP ================= -->
            <FrameLayout
                android:id="@+id/view_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <!-- Content injected dynamically: onboarding or dashboard -->
            </FrameLayout>

            <!-- ================= VIEW 4: SETTINGS & PREFERENCES ================= -->
            <LinearLayout
                android:id="@+id/view_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal"
                    android:elevation="3dp"
                    android:layout_marginBottom="20dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/tag_green_tint"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/settings_profile_initials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Alex"
                            android:textColor="@color/growth_green"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/settings_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alex"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="alex@brohousecrew.com"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btn_logout"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_field_background"
                        android:text="➜  Log Out"
                        android:textAllCaps="false"
                        android:textColor="@color/urgency_red"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_background"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budget Reset"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset the total amount spent this month to zero."
                        android:textColor="@color/text_muted"
                        android:textSize="12dp"
                        android:layout_marginBottom="14dp" />

                    <Button
                        android:id="@+id/btn_reset_spent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_field_background"
                        android:text="Reset Spent Money"
                        android:textAllCaps="false"
                        android:textColor="@color/urgency_red"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- Premium Bottom Navigation Layout Bar -->
    <LinearLayout
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tab_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/icon_tab_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/lbl_tab_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/accent_blue"
                android:textSize="10dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_inventory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/icon_tab_inventory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/lbl_tab_inventory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stash"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/tab_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <RelativeLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="9dp"
                android:background="@drawable/btn_blue_rounded"
                android:elevation="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="24sp" />
            </RelativeLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/tab_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/icon_tab_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/lbl_tab_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group"
                android:textColor="@color/primary"
                android:textSize="10dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/icon_tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="20dp"/>

            <TextView
                android:id="@+id/lbl_tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/primary"
                android:textSize="10dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
