<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/staged_item_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📦"
        android:textSize="26sp"
        android:layout_centerVertical="true" />

    <LinearLayout
        android:id="@+id/staged_info_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/staged_item_emoji"
        android:layout_toStartOf="@+id/staged_item_actions"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/staged_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/staged_item_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General"
            android:background="@drawable/tag_green_tint"
            android:textColor="@color/growth_green"
            android:textSize="10sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="2dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/staged_item_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/staged_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <ImageButton
            android:id="@+id/btn_edit_staged"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/primary"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_delete_staged"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/urgency_red"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btn_confirm_staged"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/tag_green_tint"
            android:text="✓"
            android:textColor="@color/growth_green"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</RelativeLayout>
