<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="100dp">

        <!-- WORKSPACE IDENTITY & JOINT BUDGET CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/group_display_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The BroHouse Crew"
                    android:textColor="#191C1E"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/admin_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/tag_green_tint"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="ADMIN"
                    android:textColor="#00993B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/group_code_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#E8EDF2"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/group_display_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STSH9X"
                    android:textColor="#191C1E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" ❐"
                    android:textColor="#0052FE"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8EDF2"
                android:layout_marginVertical="24dp" />

            <!-- Joint Budget Stats -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOINT MONTHLY BUDGET"
                android:textColor="#191C1E"
                android:alpha="0.5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/group_budget_spent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0"
                    android:textColor="#191C1E"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/group_budget_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / $0.00"
                    android:textColor="#191C1E"
                    android:alpha="0.4"
                    android:textSize="16sp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:background="#E8EDF2">
                <View
                    android:id="@+id/group_budget_progress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#0052FE" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Liquid Cash"
                        android:textColor="#191C1E"
                        android:alpha="0.5"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/group_liquid_cash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#0052FE"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- WORKSPACE MANAGEMENT (JOIN/SYNC) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workspace Management"
                android:textColor="#191C1E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Switch your active household stash sync."
                android:textColor="#191C1E"
                android:alpha="0.6"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_group_code_sync"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/input_field_background"
                    android:hint="Enter Code"
                    android:inputType="textCapCharacters"
                    android:paddingHorizontal="14dp"
                    android:textColor="#191C1E"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/btn_sync_group"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#0052FE"
                    android:text="Sync"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- MEMBERS SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Members"
            android:textColor="#191C1E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:id="@+id/container_group_members_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Member Items + "Add" Item will be injected here -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ACTIVITY FEED SECTION -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity Feed"
                android:textColor="#191C1E"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btn_view_all_activity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="View All"
                android:textColor="#0052FE"
                android:textStyle="bold"
                android:textSize="13sp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/container_group_activities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Timeline rows will be injected here -->
        </LinearLayout>

        <!-- ADMIN BUDGET CONTROLS -->
        <LinearLayout
            android:id="@+id/admin_budget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrative Budget Control"
                android:textColor="#191C1E"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/input_group_budget"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_field_background"
                    android:hint="Shared Limit ($)"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textColor="#191C1E"
                    android:importantForAutofill="no" />
                <Button
                    android:id="@+id/btn_update_group_budget"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#0052FE"
                    android:text="Update"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_leave_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/input_field_background"
            android:text="Disconnect from Workspace"
            android:textAllCaps="false"
            android:textColor="#BA1A1A"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
